package com.capg.layers;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class ProductDAO {
	int i;
	public int addProduct(ProductBean bean) {
		
		System.out.println("This is ProductDAO");
		
		System.out.println("Product ID: "+bean.getPid());
		System.out.println("Product Name: "+bean.getPname());
		System.out.println("Product Price: "+bean.getPrice());
		System.out.println("Product: "+ (bean.isDiscountable() == true ? "Discountable" : "Not Discountable") );
		
		
		Connection conn=null;

		String driver = "oracle.jdbc.Driver.OracleDriver";
		String url = "jdbc:oracle:thin:@localhost:1521:XE";
		String username = "capgdb";
		String password = "capgdb";
		
		try {
			
			Class.forName(driver);
			
			try {
				
				conn = DriverManager.getConnection(url,username,password);
				
				String query = "insert into product values(?,?,?,?)";
				
				PreparedStatement pstmt = conn.prepareStatement(query);
				pstmt.setInt(1, bean.getPid());
				pstmt.setString(2, bean.getPname());
				pstmt.setDouble(3,bean.getPrice());
				pstmt.setBoolean(4,bean.isDiscountable());
				
				i = pstmt.executeUpdate();
				
				conn.close();
				
			}catch(SQLException e) {
				e.printStackTrace();;
			}
			
			
		}catch(ClassNotFoundException e) {
			e.printStackTrace();;
		}
		
		return i;
	}

}
 