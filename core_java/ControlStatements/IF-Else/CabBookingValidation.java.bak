import java.util.Scanner;
class CabBookingValidation 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		
		System.out.print("Enter true if driver available else false: ");
		boolean isDriverAvailable=sc.nextBoolean();
		if(isDriverAvailable){
			System.out.print("Enter driver details\n");
			System.out.print("Enter Driver Name: ");
			String driverName=sc.next();
			System.out.print("Enter Vehicle ID: ");
			String vehicleID=sc.next();
			System.out.print("Enter Location For Service Check: ");
			String location=sc.next();
			if(location.equals("Delhi") || location.equals("Mumbai") || location.equals("LPU")){
				System.out.println("Your Location Is Servicable");
				System.out.print("Enter Payment Mode (Cash/UPI/Card): ");
				String paymentMode=sc.next();
				if(paymentMode.equals("Cash") || paymentMode.equals("UPI") || paymentMode.equals("Card")){
					System.out.println("Driver "+ driverName+ " with Vehicle ID: "+ vehicleID+ " accepted your location "+ location + " For Pickup");
					System.out.println("Cab Booked Successfully..........");
				}else{
					System.out.println("Payment Mode Not Accepted");
				}
				
			}else{
				System.out.print("Location not servicable");
			}
		}else{		
			System.out.println("Driver not available");
		}
		
		
		

	}
}
