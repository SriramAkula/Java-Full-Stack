import java.util.Scanner;
class ShoppingCartValidation 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter Cart Value: ");
		double cartValue = sc.nextDouble();
		
		if(cartValue>0){
			System.out.print("Please Enter Delivery Address: ");
			String deliveryAdd=sc.nextLine();
			if(deliveryAdd==""){
				System.out.println("Please Enter Valid Delivery Address");
			}else{
				System.out.println("Your checkout is allowed to "+deliveryAdd);
			}
			
		}else{
			System.out.println("Cart is Empty!!!");
		}
		

	}
}
