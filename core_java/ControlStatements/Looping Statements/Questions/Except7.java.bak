import java.util.Scanner;
class Except7 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter m: ");
		int m=sc.nextInt();
		System.out.print("Enter n: ");
		int n=sc.nextInt();
		for(int i=m;i<n;i++){
			boolean flag=true;
			int res=i;
			while(res>=0){
				
				int temp=res%10;
				if(temp==7){
					flag=false;
					break;
				}
				res/=10;
			}
			if(flag==true){
				System.out.print(i+" ");
			}
		}
		
	}
}