import java.util.Scanner;
class HappyNumber 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter num1 range: ");
		int a=sc.nextInt();
		System.out.print("Enter num2 range: ");
		int b=sc.nextInt();
		int c=0;
		for(int i=a;i<=b;i++){
			if(isHappyNum(i)){
				System.out.print(i+" ");
				c++;
			}
		}
		System.out.println(c);

	}
	public static boolean isHappyNum(int n){
		while(n>9){
			int temp=n;
			int res=0;
			while(temp>0){
				int ntemp=temp%10;
				res+=(ntemp*ntemp);
				temp/=10;
			}
			
			
			n=res;
			
		}
		if(n==1 || n==7){
			return true;
		}
		
		return false;
		
	}
}
