import java.util.Scanner;
class AgeCheck 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		int age=sc.nextInt("Enter Your Age: ");
		int minAge=18;
		int maxAge=65;
		
		System.out.println((age>=minAge && age<=maxAge) ? "Age is Valid" : "Age is not valid");
	}
}
